# Copy to .env and edit. Node 22+ loads it automatically (no dotenv needed).
PORT=4000
NODE_ENV=development

# SQLite file. Use ":memory:" for throw-away runs.
DB_PATH=./data/smartcare.db

# When configured, the backend uses Supabase PostgreSQL instead of SQLite.
# Keep this database password private; do not commit backend/.env.
SUPABASE_DB_URL=

# Required in every environment unless ALLOW_INSECURE_DEV_SECRET=true for local-only development.
JWT_SECRET=

# Required to enroll or verify face descriptors. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key private and back it up securely; losing it makes enrolled descriptors unreadable.
FACE_DESCRIPTOR_KEY=

# Face++ face comparison. Keep both secrets private and set them only on the backend.
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_API_BASE_URL=https://api-us.faceplusplus.com
FACEPP_COMPARE_PATH=/facepp/v3/compare
FACEPP_MATCH_THRESHOLD=80

# OCR.space ID OCR. Keep the key private and set it only on the backend.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_TIMEOUT_MS=15000

# Transactional email notifications. Brevo REST is selected automatically when
# BREVO_API_KEY and BREVO_SENDER_EMAIL are set, or set NOTIFICATION_PROVIDER explicitly.
NOTIFICATION_PROVIDER=console
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_NAME=SmartCare Dental Clinic

# Local development escape hatch only. Never enable this in production.
ALLOW_INSECURE_DEV_SECRET=false

# Comma-separated frontend origins allowed to call the API. In production, list
# every frontend origin exactly (scheme + host + optional port).
CORS_ORIGIN=http://localhost:3000

# Number of trusted reverse-proxy hops used to read X-Forwarded-For. Keep 0 unless configured.
TRUST_PROXY=0
PUBLIC_SSE_MAX_CONNECTIONS=100
PUBLIC_SSE_MAX_PER_IP=10

# Clinic time zone (all dates/times in the API are clinic-local)
CLINIC_TZ=Asia/Manila

# Optional demo role login endpoint for development and tests.
DEMO_MODE=false

# Seed sample data when the database is empty
SEED_ON_START=true

# Optional local-only administrator account bootstrap. Never set this in production.
BOOTSTRAP_ADMIN_EMAIL=allyssagrace@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=

# PayMongo hosted checkout. Keep both secrets private and set them only on the backend.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,grab_pay,paymaya
FRONTEND_URL=http://localhost:3000

# Set true when served over HTTPS
COOKIE_SECURE=false

# Business rules
SLOT_HOLD_MIN=5
PENDING_PAYMENT_TTL_MIN=30
MAX_PENDING_PER_PATIENT=2
MIN_LEAD_MIN=30
MAX_ADVANCE_DAYS=90
PATIENT_CANCEL_RESCHEDULE_HOURS=24
CLINIC_CANCELLATION_REFUNDS=true
